@using LibraryManagement.ViewModels.Member
@model MemberListViewModel

@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Members</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Member</a>
</div>

<!-- Search & Filter -->
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="searchTerm" value="@Model.SearchTerm"
               class="form-control" placeholder="Search by name or email..." />
    </div>

    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="" selected="@string.IsNullOrEmpty(Model.Status)">All</option>
            <option value="active" selected="@(Model.Status == "active")">Active</option>
            <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
        </select>
    </div>

    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-dark">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (Model.TotalItems > 0)
{
    <p class="text-muted">Showing @Model.Members.Count of @Model.TotalItems members</p>
}

@if (!Model.Members.Any())
{
    <div class="alert alert-warning">No members found.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Active Loans</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Members)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    <td>@item.ActiveLoansCount</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>

                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('@(item.IsActive ? "Deactivate" : "Activate") this member?');">
                            <button type="submit"
                                    class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Members pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-status="@Model.Status">Previous</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-status="@Model.Status">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-status="@Model.Status">Next</a>
            </li>
        </ul>
    </nav>
}