@model LibraryManagement.Models.Member

@{
    ViewData["Title"] = "Delete Member";
    var hasLoans = Model.Loans.Any();
}

<h1>Delete Member</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (hasLoans)
{
    <div class="alert alert-warning">
        This member has <strong>@Model.Loans.Count</strong> loan record(s) and cannot be deleted.
        You can deactivate the member instead to keep the loan history.
    </div>
}
else
{
    <h3 class="text-danger">Are you sure you want to delete this member?</h3>
}

<div class="mb-3">
    <h4>@Model.FullName</h4>
    <p class="mb-1 text-muted">@Model.Email</p>
    <p class="mb-0">
        Status:
        @if (Model.IsActive)
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-danger">Inactive</span>
        }
    </p>
</div>

<div>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-danger" disabled="@hasLoans">Delete</button>
    </form>

    @if (hasLoans && Model.IsActive)
    {
        <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-secondary">Deactivate instead</button>
        </form>
    }

    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>