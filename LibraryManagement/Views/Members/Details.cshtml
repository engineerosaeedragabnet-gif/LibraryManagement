@using LibraryManagement.Enums
@model LibraryManagement.Models.Member

@{
    ViewData["Title"] = Model.FullName;
}

<h1>@Model.FullName</h1>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd>

    <dt class="col-sm-3">Member Since</dt>
    <dd class="col-sm-9">@Model.MembershipDate.ToString("yyyy/MM/dd")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.IsActive)
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-danger">Inactive</span>
        }
    </dd>
</dl>

<h4 class="mt-4">Loan History (@Model.Loans.Count)</h4>

@if (!Model.Loans.Any())
{
    <p class="text-muted">No loans yet.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Book</th>
                <th>Loan Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Loans)
            {
                var badgeClass = loan.Status switch
                {
                    LoanStatus.Borrowed => "bg-primary",
                    LoanStatus.Returned => "bg-success",
                    LoanStatus.Overdue => "bg-danger",
                    _ => "bg-secondary"
                };

                <tr>
                    <td>
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@loan.BookId">@loan.Book.Title</a>
                    </td>
                    <td>@loan.LoanDate.ToString("yyyy/MM/dd")</td>
                    <td>@loan.DueDate.ToString("yyyy/MM/dd")</td>
                    <td>@(loan.ReturnDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                    <td><span class="badge @badgeClass">@loan.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>

    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="d-inline"
          onsubmit="return confirm('@(Model.IsActive ? "Deactivate" : "Activate") this member?');">
        <button type="submit" class="btn @(Model.IsActive ? "btn-secondary" : "btn-success")">
            @(Model.IsActive ? "Deactivate" : "Activate")
        </button>
    </form>

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>