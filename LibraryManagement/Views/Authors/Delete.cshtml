@model LibraryManagement.Models.Author

@{
    ViewData["Title"] = "Delete Author";
}

<h1>Delete Author</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.Books.Any())
{
    <div class="alert alert-warning">
        This author has <strong>@Model.Books.Count</strong> book(s) and cannot be deleted.
    </div>
}
else
{
    <h3 class="text-danger">Are you sure you want to delete this author?</h3>
}

<h4>@Model.FullName</h4>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger" disabled="@Model.Books.Any()">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>