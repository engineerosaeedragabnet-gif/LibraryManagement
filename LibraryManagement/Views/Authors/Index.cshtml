@using LibraryManagement.ViewModels
@model List<AuthorListItemViewModel>

@{
    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Books Count</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.FullName</td>
                <td>@author.BooksCount</td>
            </tr>
        }
    </tbody>
</table>