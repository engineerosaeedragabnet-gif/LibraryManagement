@model LibraryManagement.ViewModels.BookListViewModel

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Books</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Book</a>
</div>

<!-- Search & Filters -->
<form asp-action="Index" method="get" class="row g-2 mb-4 align-items-center">
    <div class="col-md-3">
        <input type="text" name="searchTerm" value="@Model.SearchTerm"
               class="form-control" placeholder="Title, ISBN or author..." />
    </div>

    <div class="col-md-2">
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">All Categories</option>
        </select>
    </div>

    <div class="col-md-2">
        <select name="authorId" asp-items="ViewBag.Authors" class="form-select">
            <option value="">All Authors</option>
        </select>
    </div>

    <div class="col-md-2">
        <select name="sortOrder" class="form-select">
            <option value="title" selected="@(Model.SortOrder == "title")">Title (A-Z)</option>
            <option value="newest" selected="@(Model.SortOrder == "newest")">Newest</option>
        </select>
    </div>

    <div class="col-md-1">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="availableOnly"
                   name="availableOnly" value="true" checked="@Model.AvailableOnly" />
            <label class="form-check-label" for="availableOnly">Available</label>
        </div>
    </div>

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-dark">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (Model.TotalItems > 0)
{
    <p class="text-muted">Showing @Model.Books.Count of @Model.TotalItems books</p>
}

@if (!Model.Books.Any())
{
    <div class="alert alert-warning">No books found.</div>
}

<!-- Cards -->
<div class="row">
    @foreach (var book in Model.Books)
    {
        <div class="col-sm-6 col-lg-3 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(book.CoverImagePath))
                {
                    <img src="@book.CoverImagePath" class="card-img-top" alt="@book.Title"
                         style="height:240px; object-fit:cover;" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center text-muted"
                         style="height:240px;">
                        No cover
                    </div>
                }

                <div class="card-body">
                    <h5 class="card-title">@book.Title</h5>
                    <p class="mb-1 text-muted">@book.Author.FullName</p>
                    <span class="badge bg-secondary">@book.Category.Name</span>
                    @if (book.AvailableCopies > 0)
                    {
                        <span class="badge bg-success">Available (@book.AvailableCopies)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of stock</span>
                    }
                </div>

                <div class="card-footer bg-white d-flex gap-1">
                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Books pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-authorId="@Model.AuthorId"
                   asp-route-availableOnly="@Model.AvailableOnly"
                   asp-route-sortOrder="@Model.SortOrder">Previous</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-authorId="@Model.AuthorId"
                       asp-route-availableOnly="@Model.AvailableOnly"
                       asp-route-sortOrder="@Model.SortOrder">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-authorId="@Model.AuthorId"
                   asp-route-availableOnly="@Model.AvailableOnly"
                   asp-route-sortOrder="@Model.SortOrder">Next</a>
            </li>
        </ul>
    </nav>
}