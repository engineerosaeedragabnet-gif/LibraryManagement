@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.Loans.Any())
{
    <div class="alert alert-warning">
        This book has <strong>@Model.Loans.Count</strong> loan record(s) and cannot be deleted.
    </div>
}
else
{
    <h3 class="text-danger">Are you sure you want to delete this book?</h3>
}

<div class="row mb-3">
    <div class="col-md-3">
        @if (!string.IsNullOrEmpty(Model.CoverImagePath))
        {
            <img src="@Model.CoverImagePath" alt="@Model.Title" class="img-fluid rounded" />
        }
    </div>
    <div class="col-md-9">
        <h4>@Model.Title</h4>
        <p class="mb-1">Author: @Model.Author.FullName</p>
        <p class="mb-1">Category: <span class="badge bg-secondary">@Model.Category.Name</span></p>
        <p class="mb-0">ISBN: @Model.ISBN</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger" disabled="@Model.Loans.Any()">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>