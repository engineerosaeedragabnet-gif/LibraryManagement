@model LibraryManagement.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="mb-0">Dashboard</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Loans" asp-action="Create" class="btn btn-primary">+ New Loan</a>
        <a asp-controller="Books" asp-action="Create" class="btn btn-outline-primary">+ New Book</a>
        <a asp-controller="Members" asp-action="Create" class="btn btn-outline-primary">+ New Member</a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row">
    <div class="col-6 col-lg-2 mb-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalBooks</div>
                <div class="text-muted small">Books</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-2 mb-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.AvailableCopies / @Model.TotalCopies</div>
                <div class="text-muted small">Available Copies</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-2 mb-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.ActiveMembers <span class="fs-6 text-muted">/ @Model.TotalMembers</span></div>
                <div class="text-muted small">Active Members</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-2 mb-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold text-primary">@Model.ActiveLoans</div>
                <div class="text-muted small">Active Loans</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-2 mb-3">
        <div class="card text-center shadow-sm h-100 @(Model.OverdueLoans > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="fs-2 fw-bold @(Model.OverdueLoans > 0 ? "text-danger" : "")">@Model.OverdueLoans</div>
                <div class="text-muted small">Overdue</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-2 mb-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalFines.ToString("0.00")</div>
                <div class="text-muted small">Total Fines</div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2">
    <!-- Top Books -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold">Top Borrowed Books</div>
            <div class="card-body p-0">
                @if (!Model.TopBooks.Any())
                {
                    <p class="text-muted p-3 mb-0">No loans yet.</p>
                }
                else
                {
                    <table class="table table-striped mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Loans</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.TopBooks.Count; i++)
                            {
                                var b = Model.TopBooks[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@b.BookId">@b.Title</a>
                                    </td>
                                    <td>@b.AuthorName</td>
                                    <td><span class="badge bg-secondary">@b.LoansCount</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Recent Loans -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold d-flex justify-content-between">
                <span>Recent Loans</span>
                <a asp-controller="Loans" asp-action="Index" class="small">View all</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentLoans.Any())
                {
                    <p class="text-muted p-3 mb-0">No loans yet.</p>
                }
                else
                {
                    <table class="table table-striped mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Book</th>
                                <th>Member</th>
                                <th>Due</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.RecentLoans)
                            {
                                <tr>
                                    <td>@l.BookTitle</td>
                                    <td>@l.MemberName</td>
                                    <td>@l.DueDate.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        @if (l.ReturnDate != null)
                                        {
                                            <span class="badge bg-success">Returned</span>
                                        }
                                        else if (l.IsOverdue)
                                        {
                                            <span class="badge bg-danger">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<!-- Overdue -->
<div class="card shadow-sm mb-4 @(Model.OverdueList.Any() ? "border-danger" : "")">
    <div class="card-header bg-white fw-bold @(Model.OverdueList.Any() ? "text-danger" : "")">
        Overdue Loans
    </div>
    <div class="card-body p-0">
        @if (!Model.OverdueList.Any())
        {
            <p class="text-success p-3 mb-0">No overdue loans 🎉</p>
        }
        else
        {
            <table class="table table-striped mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Due Date</th>
                        <th>Days Late</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.OverdueList)
                    {
                        <tr class="table-danger">
                            <td>@l.BookTitle</td>
                            <td>@l.MemberName</td>
                            <td>@l.DueDate.ToString("yyyy/MM/dd")</td>
                            <td>@((int)(DateTime.Now - l.DueDate).TotalDays)</td>
                            <td>
                                <a asp-controller="Loans" asp-action="Return" asp-route-id="@l.LoanId"
                                   class="btn btn-sm btn-success">Return</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>